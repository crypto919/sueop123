#include <Servo.h>

// Arduino pin assignment

#define PIN_IR    0         // IR sensor at Pin A0
#define PIN_LED   9
#define PIN_SERVO 10

#define _DUTY_MIN 1000  // servo full clock-wise position (0 degree)
#define _DUTY_NEU 2000  // servo neutral position (90 degree)
#define _DUTY_MAX 3000  // servo full counter-clockwise position (180 degree)

#define _DIST_MIN  100.0   // minimum distance 100mm (10cm)
#define _DIST_MAX  250.0   // maximum distance 250mm (25cm)

// Adjust ALPHA and LOOP_INTERVAL for stable servo operation based on distance
// ALPHA must be a value between 0 and 1 for the EMA filter calculation:
// dist_ema = EMA_ALPHA * dist_curr + (1 - EMA_ALPHA) * dist_prev;
#define EMA_ALPHA  0.05      // Adjusted for better EMA filtering (0.05 is 5.0 / 100.0)
#define LOOP_INTERVAL 20   // Loop Interval (unit: msec), set to 20msec or more as required

Servo myservo;
unsigned long last_loop_time;   // unit: msec

float dist_prev = _DIST_MIN;
float dist_ema = _DIST_MIN;

void setup()
{
  pinMode(PIN_LED, OUTPUT);

  myservo.attach(PIN_SERVO); 
  myservo.writeMicroseconds(_DUTY_NEU);

  Serial.begin(1000000);    // 1,000,000 bps (maximum speed)
}

void loop()
{
  unsigned long time_curr = millis();
  int duty;
  float a_value, dist_raw, dist_curr;

  // wait until next event time
  if (time_curr < (last_loop_time + LOOP_INTERVAL))
    return;
  last_loop_time += LOOP_INTERVAL;

  a_value = analogRead(PIN_IR);
  // Conversion formula from the assignment: dist_raw = ((6762.0 / (a_value - 9.0)) - 4.0) * 10.0;
  dist_raw = ((6762.0 / (a_value - 9.0)) - 4.0) * 10.0;

  // 1. Range Filter and LED control
  // Filter for _DIST_MIN ~ _DIST_MAX (10cm ~ 25cm)
  if (dist_raw >= _DIST_MIN && dist_raw <= _DIST_MAX) {
    // If in range, turn on LED
    digitalWrite(PIN_LED, HIGH);
    dist_curr = dist_raw; // Use the raw value for EMA if it's in the valid range
  } else {
    // If out of range, turn off LED and clamp the distance to the previous EMA value
    // This is a simple form of a range filter: keep the last known stable value
    digitalWrite(PIN_LED, LOW);
    dist_curr = dist_ema; 
  }

  // 2. EMA filter code
  // dist_ema = alpha * current_value + (1 - alpha) * previous_ema
  dist_ema = (EMA_ALPHA * dist_curr) + ((1.0 - EMA_ALPHA) * dist_ema);

  // 3. map() equivalent code for duty cycle
  // The map function equivalent (for floating-point):
  // (value - fromLow) * (toHigh - toLow) / (fromHigh - fromLow) + toLow
  // value: dist_ema, fromLow: _DIST_MIN, fromHigh: _DIST_MAX
  // toLow: _DUTY_MIN, toHigh: _DUTY_MAX
  float duty_float = (dist_ema - _DIST_MIN) * (_DUTY_MAX - _DUTY_MIN) / (_DIST_MAX - _DIST_MIN) + _DUTY_MIN;

  // The duty cycle must be an integer (int duty)
  // Ensure the duty is clamped to the min/max limits
  if (duty_float < _DUTY_MIN) {
    duty = _DUTY_MIN;
  } else if (duty_float > _DUTY_MAX) {
    duty = _DUTY_MAX;
  } else {
    duty = (int)duty_float;
  }

  myservo.writeMicroseconds(duty);

  // Serial Output Format as requested
  Serial.print("_DUTY_MIN:");  Serial.print(_DUTY_MIN);
  Serial.print(",_DIST_MIN:");  Serial.print(_DIST_MIN);
  Serial.print(",IR:");        Serial.print(a_value);
  Serial.print(",dist_raw:");  Serial.print(dist_raw);
  Serial.print(",ema:");       Serial.print(dist_ema);
  Serial.print(",servo:");     Serial.print(duty);
  Serial.print(",_DIST_MAX:"); Serial.print(_DIST_MAX);
  Serial.print(",_DUTY_MAX:"); Serial.print(_DUTY_MAX);
  Serial.println("");
}
