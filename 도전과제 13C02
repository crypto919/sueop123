#include <Servo.h>

#define PIN_SERVO 10

Servo myservo;

int _SERVO_SPEED;

void setup() {
myservo.attach(PIN_SERVO);
myservo.write(0);
delay(2000);
}

void loop() {

_SERVO_SPEED = (60 * 1000) / 180;

for (int pos = 0; pos <= 180; pos += 1) {
myservo.write(pos);
delay(_SERVO_SPEED);
}

delay(5000);

_SERVO_SPEED = (300 * 1000) / 90;

for (int pos = 180; pos >= 90; pos -= 1) {
myservo.write(pos);
delay(_SERVO_SPEED);
}

delay(10000);
}
