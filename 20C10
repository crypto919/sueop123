#define PIN_IR A0

#define MEASUREMENT_COUNT 51
#define MEASUREMENT_POSITION 0.5 

int data_collection_state = 0; 

void setup()
{
  Serial.begin(1000000); 
  Serial.println("IR Sensor Curve Fitting Data Collection Program");
  Serial.println("-------------------------------------------------");
  Serial.println("Enter 'S' to START data collection.");
}

void loop()
{
  if (Serial.available() > 0) {
    char input = Serial.read();

    if (input == 'S' || input == 's') {
      data_collection_state = 1;
      Serial.println("\n*** MEASUREMENT STARTED ***");
      Serial.println("Enter the current DISTANCE (in cm) followed by a newline,");
      Serial.println("then press ENTER to trigger measurement (e.g., 5[Enter]).");
      Serial.println("Enter 'E' to END data collection.");
      Serial.println("Format: Distance(cm), SensorValue(0-1023)");
    } 
    else if (input == 'E' || input == 'e') {
      data_collection_state = 0;
      Serial.println("\n*** MEASUREMENT ENDED ***");
      Serial.println("-------------------------------------------------");
      Serial.println("Enter 'S' to START a new collection.");
    } 
    else if (data_collection_state == 1) {
      if (isDigit(input) || input == '.') {
        String distanceStr = Serial.readStringUntil('\n');
        float distance = distanceStr.toFloat();
        
        unsigned int filtered_value = ir_sensor_filtered(MEASUREMENT_COUNT, MEASUREMENT_POSITION, 0); 

        Serial.print(distance);
        Serial.print(",");
        Serial.println(filtered_value);
        
        Serial.print("Data Collected: Distance: ");
        Serial.print(distance);
        Serial.print("cm, Sensor Value: ");
        Serial.println(filtered_value);
        Serial.println("Ready for next distance input...");
      }
    }
  }
}

float volt_to_distance(unsigned int a_value) 
{
  return (6762.0 / (a_value - 9) - 4.0) * 10.0;
}

int compare(const void *a, const void *b) {
  return (*(unsigned int *)a - *(unsigned int *)b);
}

unsigned int ir_sensor_filtered(unsigned int n, float position, int verbose)
{
  unsigned int *ir_val, ret_val;
  unsigned int start_time;
 
  if (verbose >= 2)
    start_time = millis(); 
  if ((n == 0) || (n > 100) || (position < 0.0) || (position > 1))
    return 0;
  if (position == 1.0)
    position = 0.999;
  if (verbose == 1) {
    Serial.print("n: "); Serial.print(n);
    Serial.print(", position: "); Serial.print(position); 
    Serial.print(", ret_idx: ");  Serial.println((unsigned int)(n * position)); 
  }

  ir_val = (unsigned int *)malloc(sizeof(unsigned int) * n);
  if (ir_val == NULL)
    return 0;

  if (verbose == 1)
    Serial.print("IR:");
  
  for (int i = 0; i < n; i++) {
    ir_val[i] = analogRead(PIN_IR);
    if (verbose == 1) {
        Serial.print(" ");
        Serial.print(ir_val[i]);
    }
  }

  if (verbose == 1)
    Serial.print("  => ");

  qsort(ir_val, n, sizeof(unsigned int), compare);
  ret_val = ir_val[(unsigned int)(n * position)];

  if (verbose == 1) {
    for (int i = 0; i < n; i++) {
        Serial.print(" ");
        Serial.print(ir_val[i]);
    }
    Serial.print(" :: ");
    Serial.println(ret_val);
  }
  free(ir_val);

  if (verbose >= 2) {
    Serial.print("Elapsed time: "); Serial.print(millis() - start_time); Serial.println("ms");
  }
  
  return ret_val;
}
